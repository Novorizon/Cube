    <var name="description" type="string" comment="client" />
    <var name="iconLocation" type="string" comment="client" />
    <var name="behavior" type="int" comment="client" />
    <var name="targetTeam" type="int" comment="client" />
    <var name="castRange" type="float" comment="client" />
    <var name="aoeRadius" type="float" comment="client" />
    <var name="castPoint" type="float" comment="client" />
    <var name="channelTime" type="float" comment="client" />
    <var name="cooldown" type="float" comment="client" />
    <var name="costResourceId" type="int" comment="client" />
    <var name="costCount" type="int" comment="client" />
    <var name="abilityActionGroupId" type="int" comment="client" />
    <var name="intrinsicModifierId" type="int" comment="client" />
