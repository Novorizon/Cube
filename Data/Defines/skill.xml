<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="SkillConfig">
    <var name="id" type="int" comment="client" />
    <var name="name" type="string" comment="client" />
    <var name="description" type="string" comment="client" />
    <var name="iconLocation" type="string" comment="client" />
    <var name="skillType" type="int" comment="client" />
    <var name="targetType" type="int" comment="client" />
    <var name="castMode" type="int" comment="client" />
    <var name="effectType" type="int" comment="client" />
    <var name="range" type="float" comment="client" />
    <var name="duration" type="float" comment="client" />
    <var name="cooldown" type="float" comment="client" />
    <var name="count" type="int" comment="client" />
    <var name="costItemId" type="int" comment="client" />
    <var name="costCount" type="int" comment="client" />
    <var name="unlockLevel" type="int" comment="client" />
    <var name="enable" type="bool" comment="client" />
    <var name="sortOrder" type="int" comment="client" />
    <var name="effectPrefabLocation" type="string" comment="client" />
    <var name="soundLocation" type="string" comment="client" />
  </bean>

  <table name="TbSkill" value="SkillConfig" input="skill.xlsx" mode="map" index="id" />
</module>
