<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="WaveConfig">
    <var name="id" type="int" comment="client" />
    <var name="npcConfigId" type="int" comment="client" />
    <var name="count" type="int" comment="client" />
    <var name="interval" type="float" comment="client" />
    <var name="startDelay" type="float" comment="client" />
    <var name="spawnMode" type="int" comment="client" />
    <var name="description" type="string" comment="client" />
  </bean>

  <table name="TbWave" value="WaveConfig" input="wave.xlsx" mode="map" index="id" />
</module>
