<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="BaseConfig">
    <var name="id" type="int" comment="client" />
    <var name="name" type="string" comment="client" />
    <var name="description" type="string" comment="client" />
    <var name="hp" type="int" comment="client" />
    <var name="defense" type="int" comment="client" />
    <var name="prefabLocation" type="string" comment="client" />
    <var name="iconLocation" type="string" comment="client" />
    <var name="hitEffect" type="string" comment="client" />
    <var name="deadEffect" type="string" comment="client" />
    <var name="enable" type="bool" comment="client" />
  </bean>

  <table name="TbBase" value="BaseConfig" input="base.xlsx" mode="map" index="id" />
</module>
