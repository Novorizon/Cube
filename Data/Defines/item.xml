<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="ItemConfig">
    <var name="id" type="int" comment="client" />
    <var name="name" type="string" comment="client" />
    <var name="description" type="string" comment="client" />
    <var name="itemType" type="int" comment="client" />
    <var name="useScope" type="int" comment="client" />
    <var name="iconLocation" type="string" comment="client" />
    <var name="dropPrefabLocation" type="string" comment="client" />
    <var name="autoPick" type="bool" comment="client" />
    <var name="maxStack" type="int" comment="client" />
    <var name="settlementItemId" type="int" comment="client" />
    <var name="settlementCountPerItem" type="int" comment="client" />
  </bean>

  <table name="TbItem" value="ItemConfig" input="item.xlsx" mode="map" index="id" />
</module>
