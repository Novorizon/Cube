<?xml version="1.0" encoding="utf-8"?>
<module name="">
  <bean name="TowerConfig">
    <var name="id" type="int" comment="client" />
    <var name="name" type="string" comment="client" />
    <var name="description" type="string" comment="client" />
    <var name="towerType" type="int" comment="client" />
    <var name="prefabLocation" type="string" comment="client" />
    <var name="costItemId" type="int" comment="client" />
    <var name="costCount" type="int" comment="client" />
    <var name="range" type="float" comment="client" />
    <var name="damage" type="int" comment="client" />
    <var name="attackInterval" type="float" comment="client" />
    <var name="unlockLevel" type="int" comment="client" />
    <var name="enable" type="bool" comment="client" />
    <var name="attackEffect" type="string" comment="client" />
    <var name="hitEffect" type="string" comment="client" />
    <var name="upgradeCost" type="int" comment="client" />
    <var name="SellGoldRate" type="float" comment="client" />
    <var name="canUpgrade" type="bool" comment="client" />
    <var name="iconLocation" type="string" comment="client" />
  </bean>

  <table name="TbTower" value="TowerConfig" input="tower.xlsx" mode="map" index="id" />
</module>
